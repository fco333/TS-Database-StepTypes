						<value>ResStr("SQL_ACTION_STEP_TYPE", "DESCRIPTION") +
(((Step.Operation&lt;0) || ((Step.Operation&lt;6) &amp;&amp; (Step.RecordToOperateOn&lt;0))) ? ResStr("DATABASE_GENERAL", "NOTSPECIFIED") :
 (
  (Step.Operation==0?ResStr("SQL_ACTION_STEP_TYPE", "DESC_FETCH") :
   (Step.Operation==1?ResStr("SQL_ACTION_STEP_TYPE", "DESC_SET") :
    (Step.Operation==2?ResStr("SQL_ACTION_STEP_TYPE", "DESC_GET") :
     (Step.Operation==3?ResStr("SQL_ACTION_STEP_TYPE", "DESC_PUT") :
      (Step.Operation==4?ResStr("SQL_ACTION_STEP_TYPE", "DESC_DELETE") :
       (Step.Operation==5?ResStr("SQL_ACTION_STEP_TYPE", "DESC_SET_AND_PUT") : 
        (Step.Operation==6?ResStr("SQL_ACTION_STEP_TYPE", "DESC_EXECUTE_PROC") : 
         (Step.Operation==7?ResStr("SQL_ACTION_STEP_TYPE", "DESC_CLOSE_PROC") : 
          ResStr("DATABASE_GENERAL", "NOTSPECIFIED") 
  )))))))) + 
  " " + ((Step.Operation&lt;6) ? (
  (Step.RecordToOperateOn==0?ResStr("SQL_ACTION_STEP_TYPE", "DESC_NEW") :
   (Step.RecordToOperateOn==1?ResStr("SQL_ACTION_STEP_TYPE", "DESC_CURRENT") :
    (Step.RecordToOperateOn==2?ResStr("SQL_ACTION_STEP_TYPE", "DESC_NEXT") :
     (Step.RecordToOperateOn==3?ResStr("SQL_ACTION_STEP_TYPE", "DESC_PREVIOUS") :
      (Step.RecordToOperateOn==4?ResStr("SQL_ACTION_STEP_TYPE", "DESC_INDEX") + "(" + LocalizeExpression(Step.RecordIndex) +")" :
       ResStr("DATABASE_GENERAL", "NOTSPECIFIED") 
  ))))) +
  ResStr("SQL_ACTION_STEP_TYPE", "RECORD")
) : "" )
))</value>
