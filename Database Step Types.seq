										</Name>
										<ValueToLog classname='ExprValue'>
											<value>/*
This expression computes a string with the ColumnName and Data from each element of the column list array. The expression recursively evaluates an expression to iterate through the column list array.
*/
#NoValidation( // Because we are using dynamically created variables.
RunState.Thread.RunTimeVariables.SetValInterface("NI_TestStand_DBStepTemp.ColumnList", PropOption_InsertIfMissing, Evaluate(Step.ColumnListSource)),
RunState.Thread.RunTimeVariables.SetValNumber("NI_TestStand_DBStepTemp.LowerBounds", PropOption_InsertIfMissing, (*RunState.Thread.RunTimeVariables.NI_TestStand_DBStepTemp.ColumnList).Type.ArrayDimensions.GetLowerBounds()[0]),
RunState.Thread.RunTimeVariables.SetValNumber("NI_TestStand_DBStepTemp.UpperBounds", PropOption_InsertIfMissing, RunState.Thread.RunTimeVariables.NI_TestStand_DBStepTemp.LowerBounds + GetNumElements((*RunState.Thread.RunTimeVariables.NI_TestStand_DBStepTemp.ColumnList)) - 1),
RunState.Thread.RunTimeVariables.SetValNumber("NI_TestStand_DBStepTemp.Index", PropOption_InsertIfMissing, RunState.Thread.RunTimeVariables.NI_TestStand_DBStepTemp.LowerBounds - 1), // - 1 for initial ++
RunState.Thread.RunTimeVariables.SetValString("NI_TestStand_DBStepTemp.NameValueExpr", PropOption_InsertIfMissing, "Str(Evaluate((*RunState.Thread.RunTimeVariables.NI_TestStand_DBStepTemp.ColumnList)[RunState.Thread.RunTimeVariables.NI_TestStand_DBStepTemp.Index].GetValString(\"ColumnName\", 0))) + \" = \" + Str(Evaluate((*RunState.Thread.RunTimeVariables.NI_TestStand_DBStepTemp.ColumnList)[RunState.Thread.RunTimeVariables.NI_TestStand_DBStepTemp.Index].GetValString(\"Data\", 0)))"),
RunState.Thread.RunTimeVariables.SetValString("NI_TestStand_DBStepTemp.SeparatorExpr", PropOption_InsertIfMissing, "RunState.Thread.RunTimeVariables.NI_TestStand_DBStepTemp.Index &lt; RunState.Thread.RunTimeVariables.NI_TestStand_DBStepTemp.UpperBounds ? LocalizeExpression(\", \") : \"\""),
RunState.Thread.RunTimeVariables.SetValString("NI_TestStand_DBStepTemp.NameValueListExpr", PropOption_InsertIfMissing, 
    "++RunState.Thread.RunTimeVariables.NI_TestStand_DBStepTemp.Index,
    RunState.Thread.RunTimeVariables.NI_TestStand_DBStepTemp.Index &lt;= RunState.Thread.RunTimeVariables.NI_TestStand_DBStepTemp.UpperBounds ? Evaluate(RunState.Thread.RunTimeVariables.NI_TestStand_DBStepTemp.NameValueExpr) + Evaluate(RunState.Thread.RunTimeVariables.NI_TestStand_DBStepTemp.SeparatorExpr) + Evaluate(RunState.Thread.RunTimeVariables.NI_TestStand_DBStepTemp.NameValueListExpr) : \"\""),
RunState.Thread.RunTimeVariables.SetValString("NI_TestStand_DBStepTemp.Result", PropOption_InsertIfMissing, Evaluate(RunState.Thread.RunTimeVariables.NI_TestStand_DBStepTemp.NameValueListExpr)),
RunState.Thread.RunTimeVariables.DeleteSubProperty("NI_TestStand_DBStepTemp.ColumnList", 0), // To avoid reference lifetime extension issues.
RunState.Thread.RunTimeVariables.NI_TestStand_DBStepTemp.Result
)</value>
